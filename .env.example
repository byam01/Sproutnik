# Sproutnik — Environment Configuration Template
# 
# Note: Sproutnik is architected to run out of the box with zero mandatory
# external API keys. NASA POWER Daily Point API is a publicly accessible scientific
# service, and the client/server uses an in-memory repository for demonstration.
#
# Copy this file to .env.local if you wish to override default server settings:
#   cp .env.example .env.local

# Server Port (optional, default: 3000)
PORT=3000

# Base Application URL (optional, default: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
